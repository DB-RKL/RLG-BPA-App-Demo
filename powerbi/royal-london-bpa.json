        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1a1c1c"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 95
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f9f9f9"
              }
            },
            "transparency": 0
